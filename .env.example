PORTAL_API_URL=https://portal-api.moonsama.com
PORTAL_WEB_URL=https://portal.moonsama.com

# Sandbox API key pair. Never commit real values.
PORTAL_API_KEY=
PORTAL_API_SECRET=

# Sandbox OAuth client configured with this exact redirect URI.
PORTAL_OAUTH_CLIENT_ID=
PORTAL_OAUTH_CLIENT_SECRET=
PORTAL_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/callback

# The sample /buyrelic command needs spend. Keep unused write routes disabled.
PORTAL_SPEND_ENABLED=true
PORTAL_REWARD_ENABLED=false
PORTAL_REFUND_ENABLED=false
PORTAL_HOLDS_ENABLED=false

# Optional: MineSkin API key (https://account.mineskin.org) so MoonsamaWardrobe can have
# composed skins Mojang-signed. Leave empty to run the wardrobe in browse-only mode.
MINESKIN_API_KEY=

# SQLite journal mode for plugins/MoonsamaCore/data.db: wal (default on a real disk) or
# truncate. compose.yaml already forces truncate because ./dev-data is a Docker bind mount.
# MOONSAMA_SQLITE_JOURNAL_MODE=truncate
